# Copier vers backend/.env et adapter
DJANGO_SECRET_KEY=changer-moi
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Sans DATABASE_URL, le dev utilise SQLite. En production, PostgreSQL est obligatoire.
DATABASE_URL=postgres://proxicredit:proxicredit@localhost:5432/proxicredit
REDIS_URL=redis://localhost:6379/0
TIME_ZONE=Africa/Kinshasa
