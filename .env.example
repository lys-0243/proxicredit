# Production : copier vers .env à la racine (à côté de docker-compose.yml)
DJANGO_SECRET_KEY=generer-une-longue-cle-aleatoire
DJANGO_ALLOWED_HOSTS=proxicredit.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://proxicredit.example.com
CORS_ALLOWED_ORIGINS=https://proxicredit.example.com
POSTGRES_PASSWORD=generer-un-mot-de-passe-solide
TIME_ZONE=Africa/Kinshasa

# Avec docker-compose.staging.yml (HTTPS automatique par Caddy) : nom de domaine du serveur,
# sans https://. Sans domaine : proxicredit.<IP-avec-tirets>.sslip.io (ex. proxicredit.164-90-1-2.sslip.io)
DOMAIN=proxicredit.example.com

# Serveur de test uniquement : autorise `manage.py creer_comptes_demo --mot-de-passe ...`
DEMO_AUTORISE=False
